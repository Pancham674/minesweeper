@model Board
<div id="board"
    data-columns='@Model.Columns'
    data-rows='@Model.Rows'
    data-cellsCount='@Model.CellsCount'
    data-bombCount='@Model.BombsCount'>
    
    @for (int r = 0; r < Model.Rows; r++)
    {
        <div class="board-row">
            @for (int c = 0; c < Model.Columns; c++)
            {
                <div class="partialCell">
                    <partial name="_Cell.cshtml" model="Model.Cells[c,r]" />
                </div>
            }
        </div>
    }
</div>