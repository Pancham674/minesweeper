@model Board
<button class="resetsGame resetbtn" data-column="@Model.Columns" data-row="@Model.Rows">Reset</button>

<div id="board" data-board='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))'>
    <table>
        @for (int row = 0; row < Model.Rows; row++)
        {
            <tr>
                @for (int col = 0; col < Model.Columns; col++)
                {
                    <td>
                        <button class="field" data-column="@col" data-row="@row"></button>
                    </td>
                }
            </tr>
        }
    </table>
</div>