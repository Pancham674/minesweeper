@model Cell

<button class="cell"
    data-column='@Model.Column'
    data-row='@Model.Row'
    data-neighboringBombs='@Model.NeighboringBombs'
    data-isFlagged='@Model.IsFlagged'
    data-isRevealed='@Model.IsRevealed'
    data-isExploded='@Model.IsExploded'>
        @(
            Model.IsExploded ? "💥" :
                !Model.IsRevealed && Model.IsFlagged ? "🚩" :
                    Model.IsRevealed && Model.IsBomb ? "💣" :
                        Model.IsRevealed ? Model.NeighboringBombs : ""
        )
</button>