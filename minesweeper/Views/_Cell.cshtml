@model Cell

<button class="cell"
    data-model='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))'>
        @(
            Model.IsExploded ? "💥" :
                !Model.IsRevealed && Model.IsFlagged ? "🚩" :
                    Model.IsRevealed ? Model.NeighboringBombs : ""
        )
</button>